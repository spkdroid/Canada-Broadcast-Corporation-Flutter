# Environment Configuration for CBC News Reader
# Copy this to .env and update with your actual API keys

# News API Configuration
NEWS_API_KEY=your_news_api_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# CBC News API Configuration  
CBC_NEWS_API_BASE_URL=https://rss.cbc.ca/lineup/topstories.xml

# App Configuration
APP_NAME=CBC News Reader
APP_VERSION=1.0.0
DEBUG_MODE=true

# Network Configuration
NETWORK_TIMEOUT=30000
RETRY_COUNT=3

# Cache Configuration
CACHE_DURATION_MINUTES=30